void troca(int[3] v, int[3] outro)
{
    v = outro;
    println("dentro: ", v[0], " ", v[1], " ", v[2]);
}

int[3] primeira(int[2][3] m)
{
    return m[0];
}

int soma(int[3] v)
{
    return v[0] + v[1] + v[2];
}

main()
{
    int[2][3] m;
    int[3] linha, copia;
    int i, total;
    scanf(m[0][0], m[0][1], m[0][2], m[1][0], m[1][1], m[1][2]);
    println(m[1][2]);
    linha = m[1];
    println("linha: ", linha[0], " ", linha[1], " ", linha[2]);
    copia = linha;
    scanf(copia[0]);
    println("original: ", linha[0], " copia: ", copia[0]);
    func troca(linha, m[0])
    println("fora: ", linha[0], " ", linha[1], " ", linha[2]);
    linha = func primeira(m);
    println("primeira: ", linha[0], " ", linha[1], " ", linha[2]);
    total = func soma(m[1]);
    println("soma m[1]: ", total);
    i = 1;
    println(m[i][i + 1]);
}
